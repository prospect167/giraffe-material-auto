# 本地配置文件示例
# 复制此文件为 application-local.yml 并填写实际的密钥
# application-local.yml 不会被提交到 git（已在 .gitignore 中配置）

# AI图像处理配置（图片去重）
# 使用豆包 Seedream 4.5 模型（火山引擎方舟平台）
# 参考文档：https://www.volcengine.com/docs/82379/1824121?lang=zh
ai-image-processing:
  doubao:
    enabled: true
    # API Key（从火山引擎方舟控制台获取）
    # 获取地址：https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
    api-key: 你的API密钥
    # API基础地址（无需修改）
    base-url: https://ark.cn-beijing.volces.com/api/v3
    # 模型ID：豆包 Seedream 4.5
    # 也可以替换为你的模型端点ID：ep-xxxxxxxx
    model: doubao-seedream-4-5-251128
    # 生成图片尺寸
    size: 2K
    # 图生图强度（0.0-1.0），值越小越接近原图，值越大水印去更干净，推荐0.45-0.55
    strength: 0.50
    # 提示词管理：集中在常量类 com.prospect.giraffe.material.constants.PromptConstants
